NODE_ENV=development
PORT=8080
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Preferred connection style
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/react_ecommerce

# Optional discrete settings (used if DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=react_ecommerce
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

JWT_SECRET=replace_with_a_very_long_random_secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=token
BCRYPT_SALT_ROUNDS=12
